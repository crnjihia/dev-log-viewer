# Environment Configuration for Dev Log Viewer
# Timezone: Africa/Nairobi (EAT / UTC+3)

# App mode (development | production)
NODE_ENV=development

# Kenyan Localization: default language (en | sw)
VITE_DEFAULT_LOCALE=en

# Memory mapping & index tuning (in megabytes)
# Maximum chunk size for parallel scanning
VITE_INDEX_CHUNK_SIZE_MB=64

# Maximum line length cap before truncating in viewport preview (in characters)
VITE_MAX_LINE_LENGTH_PREVIEW=10000

# Live tail poll interval fallback in milliseconds
VITE_TAIL_POLL_INTERVAL_MS=250

